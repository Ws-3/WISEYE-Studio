+
+TEST(FastPhysicsModel, WallContactPreservesNewControlResponse) {
+  projectairsim::FastPhysicsModel model;
+  auto body = std::make_shared<projectairsim::TestFastPhysicsBody>();
+  auto fp_body = std::static_pointer_cast<projectairsim::FastPhysicsBody>(body);
+  body->SetMass(1.0f);
+  body->SetInertia(projectairsim::Matrix3x3::Identity());
+  body->SetRestitution(0.1f);
+  body->SetFriction(0.0f);
+  projectairsim::Kinematics current;
+  current.pose.orientation = projectairsim::Quaternion::Identity();
+  body->SetKinematics(current);
+  projectairsim::CollisionInfo contact;
+  contact.normal = {-1., 0., 0.};
+  contact.position = {0., 0., -10.};
+  contact.impact_point = contact.position;
+  contact.penetration_depth = 0.;
+  body->SetCollisionInfo(contact);
+  projectairsim::Kinematics predicted = current;
+  predicted.twist.linear = {0.1, 0.2, -0.3};
+  predicted.pose.orientation =
+      projectairsim::TransformUtils::ToQuaternion(0., 0., 0.01);
+  auto result = model.CalcNextKinematicsWithCollision(.01, fp_body, &predicted);
+  EXPECT_LT(result.twist.linear.x(), 0.);  // stop/rebound at the wall
+  EXPECT_GT(result.twist.linear.y(), 0.);  // new tangential control survives
+  EXPECT_LT(result.twist.linear.z(), 0.);  // new lift survives contact
+  EXPECT_LT(result.pose.position.x(), -0.001f);
+  EXPECT_TRUE(result.pose.orientation.isApprox(predicted.pose.orientation));
+  EXPECT_TRUE(result.twist.linear.allFinite());
 }
 
