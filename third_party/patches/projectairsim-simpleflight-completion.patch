+bool SimpleFlightApi::Land(float timeout_sec,
+                           int64_t command_start_time_nanos) {
+  const bool landed = MultirotorApiBase::Land(timeout_sec,
+                                               command_start_time_nanos);
+  if (landed) {
+    // The base command has already confirmed sustained near-zero vertical
+    // velocity at touchdown. Synchronize SimpleFlight's state machine with
+    // that authoritative result; motor-output inference can miss API landings.
+    firmware_->OffboardApi().SetLandedState(true);
+  }
+  return landed;
+}
